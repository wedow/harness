#!/usr/bin/env bash
# Single-chat CLI and independently restartable runtime components.
set -euo pipefail
(( BASH_VERSINFO[0]>=4 )) || { printf 'harness: bash 4+ required\n' >&2; exit 1; }
HARNESS_ROOT="${HARNESS_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "${HARNESS_ROOT}/lib/bootstrap.sh"
source "${HARNESS_ROOT}/lib/store.sh"
source "${HARNESS_ROOT}/lib/services.sh"

main() {
  local cmd="${1:-start}" binary
  [[ $# -eq 0 ]] || shift
  command -v jq >/dev/null || _die 'required: jq'
  command -v flock >/dev/null || _die 'required: flock (Linux util-linux)'
  [[ "${HARNESS_WORKERS:-5}" =~ ^[1-9][0-9]*$ ]] || _die 'HARNESS_WORKERS must be a positive integer'
  store_init; _refresh_sources
  case "${cmd}" in
    start) service_start "${1:-all}"; printf 'chat: http://127.0.0.1:%s\n' "${HARNESS_SERVE_PORT:-8080}" ;;
    stop) service_stop "${1:-all}" ;;
    restart) service_stop "${1:-all}"; service_start "${1:-all}" ;;
    serve) exec "${HARNESS_ROOT}/lib/component" web "${HARNESS_ROOT}/plugins/web/commands/serve" "$@" ;;
    reactor) exec "${HARNESS_ROOT}/lib/component" reactor "${HARNESS_ROOT}/lib/reactor" ;;
    worker) exec "${HARNESS_ROOT}/lib/component" "worker-${1:-1}" "${HARNESS_ROOT}/lib/worker" "${1:-1}" ;;
    submit) if (( $# )); then store_submit "$*"; else store_submit "$(cat)"; fi ;;
    cancel) store_cancel main ;;
    history) store_feed 0 0 "${1:-100}" ;;
    status) store_status ;;
    tools) harness_tools ;;
    version|--version|-v) printf 'harness %s\n' "${HARNESS_VERSION}" ;;
    help|--help|-h)
      printf '%s\n' 'harness start|stop|restart [all|web|reactor|worker-N]' 'harness serve [port] | reactor | worker [N]' 'harness submit [message] | history [limit] | status | cancel' 'harness tools | auth | version'
      ;;
    *) binary="$(harness_find commands "${cmd}")" || _die "unknown command: ${cmd}"; exec "${binary}" "$@" ;;
  esac
}
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then main "$@"; fi
