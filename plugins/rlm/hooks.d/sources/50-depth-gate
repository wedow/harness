#!/usr/bin/env bash
# 50-depth-gate — at RLM_MAX_DEPTH (default 2), drop this plugin from the
# source list. Leaf subagents then inherit none of rlm's prompts/hooks/tools.
# Mirrors
# 40-scope-providers: stdin/stdout is {sources:[...]}.
set -euo pipefail

depth="${HARNESS_DEPTH:-0}"
max_depth="${RLM_MAX_DEPTH:-2}"
[[ "${depth}" =~ ^[0-9]+$ ]] || { echo "HARNESS_DEPTH must be a non-negative integer" >&2; exit 1; }
[[ "${max_depth}" =~ ^[0-9]+$ ]] || { echo "RLM_MAX_DEPTH must be a non-negative integer" >&2; exit 1; }
depth=$(( 10#${depth} )); max_depth=$(( 10#${max_depth} ))

(( depth >= max_depth )) || { cat; exit 0; }

# This hook's own dir: …/plugins/rlm/hooks.d/sources -> up two = …/plugins/rlm
self="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
jq --arg self "${self}" '{sources: (.sources | map(select(. != $self)))}'
