#!/usr/bin/env bash
# 25-compact — archive-based compaction. When total message content exceeds
# RLM_COMPACT_TOTAL (default 200000 chars), archives the current messages dir
# and injects a continuation message. Signals reassembly via next_state=assemble.
set -euo pipefail

payload="$(cat)"

session="${HARNESS_SESSION:-}"
[[ -n "${session}" && -d "${session}/messages" ]] || { echo "${payload}"; exit 0; }

total_threshold="${RLM_COMPACT_TOTAL:-200000}"
msg_dir="${session}/messages"

# Estimate total content size from message files on disk
total_size=0
for f in "${msg_dir}"/*.md; do
  [[ -f "${f}" ]] || continue
  size="$(wc -c < "${f}")"
  total_size=$((total_size + size))
done

if (( total_size < total_threshold )); then
  echo "${payload}"
  exit 0
fi

# Archive current messages
ts="$(date +%s)"
archive_dir="${session}/archives/${ts}"
mkdir -p "${archive_dir}"
mv "${msg_dir}" "${archive_dir}/messages"
mkdir -p "${msg_dir}"

# Write continuation message
cat > "${msg_dir}/0001-user.md" <<EOF
---
role: user
seq: 0001
timestamp: $(date -Iseconds)
---
[Session continuation after compaction]

The previous conversation exceeded the context threshold and was archived.
Archives are at ${session}/archives/ (most recent: ${ts}).

Do not continue the prior task from memory or guesswork. Your first action MUST be archive recovery using subagents, but recover by search, not bulk ingestion.

Required recovery protocol:
1. Act as a thin recovery coordinator. Do not read archived files end-to-end yourself except tiny files or targeted line windows.
2. Build a cheap inventory of ${session}/archives/${ts}/messages/ first: file names, roles, counts, sizes, and small previews using shell tools such as find, wc, grep, head, tail, or line-window reads.
3. Spawn focused subagents to inspect the archive intentionally. Subagents may recursively use their own subagents when the archive is large or questions split naturally, but every level must sip context first: inventory, grep, head/tail, and targeted line windows before larger reads.
4. Prefer user and assistant messages for objective, decisions, plans, and current state. Treat tool_result messages as secondary evidence. Read tool results only when a specific question requires their output.
5. Have subagents produce an ultra-slim recovery summary plus an index of the most important archived regions. The index must include citations to specific archive message files, and line ranges when useful, so you can tendril back into the archive for details instead of relying on a lossy summary.
6. Recover at minimum: active objective, active skill/workflow in progress, whether any skill must be reinvoked to continue cleanly, completed steps, pending next action, relevant files/tickets/commands, blockers or failures, and decisions already made. Query project files, git, tickets, or notes when archive findings show those are needed to resume safely.
7. If an active skill was in progress, reinvoke/load that skill before resuming its workflow, then follow its instructions from the recovered state.
8. Write the recovered state to ${session}/notes/post-compaction-recovery.md.

Only after that recovery note exists should you resume the task. Use additional narrow subagent archive queries whenever the summary is insufficient.
EOF

# Signal reassembly — the assemble pipeline will re-run with fresh messages
printf '{"next_state": "assemble"}\n'
