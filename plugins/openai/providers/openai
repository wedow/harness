#!/usr/bin/env bash
# OpenAI-compatible Chat Completions; canonical JSON in and normalized JSON out.
set -euo pipefail

[[ "${1:-}" == --describe ]] && { echo 'OpenAI-compatible chat completions API'; exit 0; }
[[ "${1:-}" == --ready ]] && {
  [[ -n "${OPENAI_API_KEY:-}" || -n "${OPENAI_API_URL:-}" ]] && exit 0
  cache="${HARNESS_HOME:-${HOME}/.harness}/.auth-cache.json"
  [[ -f "${cache}" ]] && jq -e '.openai[0].key | type == "string" and length > 0' "${cache}" >/dev/null
  exit $?
}
[[ "${1:-}" == --defaults ]] && { echo 'model=gpt-4o'; exit 0; }
[[ "${1:-}" == --env ]] && {
  printf '%s\n' 'OPENAI_API_KEY     API key (optional for local servers)' 'OPENAI_API_URL     API endpoint (https://api.openai.com/v1/chat/completions)' 'OPENAI_MAX_TOKENS  max response tokens (16384)'
  exit 0
}
[[ $# == 0 ]] || { echo 'unsupported provider option' >&2; exit 1; }
source "${HARNESS_ROOT:-$(cd "$(dirname "$0")/../../.." >/dev/null && pwd)}/lib/provider.sh"

payload="$(_provider_validate_request)"
# provider_call keeps its HARNESS_MODEL changes inside its own subshell.
# shellcheck disable=SC2031
request="$(printf '%s' "${payload}" | jq -ce --arg model "${HARNESS_MODEL:-}" --argjson budget "${OPENAI_MAX_TOKENS:-16384}" '
  def assistant_message:
    if .provider_state.protocol == "openai" then
      if .provider_state.message.role == "assistant" then .provider_state.message else error("invalid native continuation") end
    else {role:"assistant",content:([.blocks[] | select(.type == "text") | .text] | join("")),
      tool_calls:[.blocks[] | select(.type == "tool_call") |
        {id:.id,type:"function",function:{name:.name,arguments:(.input|tojson)}}]}
      | if (.tool_calls|length) == 0 then del(.tool_calls) else . end end;
  . as $p
  | {model:(.model // $model),max_tokens:$budget,messages:
    ((if (.system // "" | length) > 0 then [{role:"system",content:.system}] else [] end)
     + [.messages[] | if .role == "user" then {role:"user",content:.content}
       elif .role == "tool" then {role:"tool",tool_call_id:.call_id,content:.content}
       else assistant_message end])}
  | if ($p.tools // [] | length) > 0 then .tools=[$p.tools[] |
      {type:"function",function:{name:.name,description:.description,parameters:.input_schema}}] else . end
  ' 2>/dev/null)" || { echo 'invalid OpenAI message continuation' >&2; exit 1; }
if [[ -n "${HARNESS_THINKING:-}" && "${HARNESS_THINKING}" != off ]]; then
  effort="${HARNESS_THINKING}"
  [[ "${effort}" != max ]] || effort=high
  request="$(printf '%s' "${request}" | jq -c --arg effort "${effort}" '.reasoning_effort=$effort')"
fi
for field in temperature top_p; do
  var="OPENAI_$(printf '%s' "${field}" | tr '[:lower:]' '[:upper:]')"
  [[ -z "${!var:-}" ]] || request="$(printf '%s' "${request}" | jq -c --arg key "${field}" --argjson value "${!var}" '.[$key]=$value')"
done
key="${OPENAI_API_KEY:-}"
[[ -n "${key}" ]] || key="$(_provider_cached_key openai)"
headers=(-H 'content-type: application/json')
[[ -z "${key}" ]] || headers+=(-H "Authorization: Bearer ${key}")
response="$(printf '%s' "${request}" | curl -sS "${OPENAI_API_URL:-https://api.openai.com/v1/chat/completions}" "${headers[@]}" -d @- --max-time "${HARNESS_CURL_MAX_TIME:-5400}")" || { echo 'OpenAI request failed' >&2; exit 1; }
normalized="$(printf '%s' "${response}" | jq -ce -s '
  if length != 1 then error("invalid response") else .[0] end
  | if .error != null or (.choices | type) != "array" or (.choices | length) != 1 then error("API error or missing choice") else . end
  | . as $r | .choices[0] as $c | $c.message as $m
  | if $m.role != "assistant" then error("missing assistant message") else . end
  | {blocks:([
      (if ($m.content | type) == "string" then {type:"text",text:$m.content}
       elif $m.content == null then empty
       elif ($m.content | type) == "array" then $m.content[] | if .type == "text" then {type:"text",text:.text} else error("unsupported content") end
       else error("invalid text") end),
      (($m.tool_calls // [])[] | if .type == "function" then
        {type:"tool_call",id:.id,name:.function.name,input:(.function.arguments | fromjson)}
        else error("unsupported tool call") end)]),
    stop:(if $c.finish_reason == "tool_calls" then "tool_calls"
      elif $c.finish_reason == "length" then "length"
      elif $c.finish_reason == "stop" then "end" else error("missing or unsupported stop reason") end),
    usage:{input_tokens:.usage.prompt_tokens,output_tokens:.usage.completion_tokens,
      total_tokens:(if .usage.total_tokens != null then .usage.total_tokens elif .usage.prompt_tokens != null and .usage.completion_tokens != null then .usage.prompt_tokens+.usage.completion_tokens else null end),
      cache_read_input_tokens:.usage.prompt_tokens_details.cached_tokens,cache_creation_input_tokens:.usage.prompt_tokens_details.cache_write_tokens},
    provider_state:{protocol:"openai",message:$m}}
  ' 2>/dev/null)" || { echo 'OpenAI API returned an error or malformed response/tool arguments' >&2; exit 1; }
printf '%s' "${normalized}" | _provider_validate_response
