#!/usr/bin/env bash
# 10-save — save a tool result and route to next tool or back to assemble.
# Receives JSON: {call_id, name, input, result, error, tool_calls: [...]}.
# Emits: {next_state: "tool_exec", tool_calls: [...]} if more remain,
#        {next_state: "assemble"} if done.
set -euo pipefail

data="$(cat)"
msg_dir="${HARNESS_SESSION}/messages"
[[ -d "${msg_dir}" ]] || exit 0

# Reserve a sequence shared with web inserts and provider receive hooks.
source "${HARNESS_ROOT}/plugins/core/lib/session.sh"
seq="$(_claim_message_seq "${HARNESS_SESSION}")"

call_id="$(echo "${data}" | jq -r '.call_id')"
tool="$(echo "${data}" | jq -r '.name')"
error="$(echo "${data}" | jq -r '.error')"
result="$(echo "${data}" | jq -r '.result')"
# `intent` is a standard optional tool input (docs/PROTOCOLS.md): ignored by
# execution, persisted here so UIs can label collapsed tool results.
intent="$(echo "${data}" | jq -r '.input.intent // empty')"
# Flat JSON results render as YAML for readable transcripts; others verbatim.
_lib="$(dirname "$(readlink -f "$0")")/../../lib"
rendered="$(printf '%s' "${result}" | "${_lib}/render-result" 2>/dev/null || printf '%s' "${result}")"
[[ -n "${rendered}" || -z "${result}" ]] || rendered="${result}"   # renderer failure guard

{
  cat <<EOF
---
role: tool_result
seq: ${seq}
timestamp: $(date -Iseconds)
call_id: ${call_id}
tool: ${tool}
error: ${error}
EOF
  [[ -n "${intent}" ]] && printf 'intent: %s\n' "${intent}"
  printf -- '---\n%s\n' "${rendered}"
} > "${msg_dir}/${seq}-tool_result.md"

[[ -n "${HARNESS_SESSION:-}" ]] && printf '%s\n' "$(jq -c -n --arg id "${call_id}" --arg name "${tool}" --arg seq "${seq}" --arg error "${error}" '{type:"tool_done",id:$id,name:$name,seq:$seq,error:$error}')" >> "${HARNESS_SESSION}/.stream"

# Route: more tool calls remaining → tool_exec, otherwise → assemble
remaining="$(echo "${data}" | jq -c '.tool_calls')"
if [[ "$(echo "${remaining}" | jq 'length')" -gt 0 ]]; then
  echo "${remaining}" | jq '{next_state: "tool_exec", tool_calls: .}'
else
  echo '{"next_state": "assemble"}'
fi
