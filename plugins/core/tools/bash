#!/usr/bin/env bash
# bash — tool plugin: execute a bash command and return stdout+stderr.
set -euo pipefail

case "${1:-}" in
  --schema)
    cat <<'JSON'
{
  "name": "bash",
  "description": "Execute a bash command in the working directory. Returns combined stdout and stderr. Use for running scripts, installing packages, file operations, or any shell command.",
  "input_schema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "The bash command to execute"
      },
      "timeout": {
        "type": "integer",
        "description": "Timeout in seconds (default: 120)"
      }
    },
    "required": ["command"]
  }
}
JSON
    ;;
  --describe)
    echo "Execute bash commands"
    ;;
  --exec)
    input="$(cat)"
    command="$(echo "${input}" | jq -r '.command')"
    tool_timeout="$(echo "${input}" | jq -r '.timeout // empty')"
    # Run in the session's original cwd if available
    cwd="${HARNESS_CWD:-${PWD}}"
    cd "${cwd}" 2>/dev/null || true
    # Resolve real bash before modifying PATH (tool-bin/ may shadow 'bash')
    _bash="$(type -P bash)"
    # Put discovered tools on PATH so scripts can invoke them by name (incl.
    # recursive `agent` calls). Build a filtered symlink dir from HARNESS_SOURCES,
    # rebuilt per call so it tracks runtime plugin changes. 'bash' is excluded so
    # nested shell calls hit the real bash; later sources win, matching tool_exec.
    if [[ -n "${HARNESS_SOURCES:-}" ]]; then
      tool_bin="${HARNESS_SESSION:-$(mktemp -d)}/.tool-bin"
      mkdir -p "${tool_bin}"
      IFS=':' read -ra _srcs <<< "${HARNESS_SOURCES}"
      for _s in "${_srcs[@]}"; do
        [[ -d "${_s}/tools" ]] || continue
        for _f in "${_s}/tools"/*; do
          [[ -x "${_f}" ]] || continue
          _n="$(basename "${_f}")"
          [[ "${_n}" == "bash" ]] && continue
          ln -sf "$(realpath "${_f}")" "${tool_bin}/${_n}"
        done
      done
      export PATH="${tool_bin}:${PATH}"
    fi
    # Execute with a timeout, capture both stdout and stderr
    _timeout="${tool_timeout:-${HARNESS_TOOL_TIMEOUT:-120}}"
    if command -v timeout &>/dev/null; then
      timeout "${_timeout}" "${_bash}" -c "${command}" 2>&1 || true
    else
      # macOS: background + watchdog kill (no GNU timeout)
      "${_bash}" -c "${command}" 2>&1 & _pid=$!
      ( sleep "${_timeout}" && kill "${_pid}" 2>/dev/null ) & _wd=$!
      wait "${_pid}" 2>/dev/null || true
      kill "${_wd}" 2>/dev/null || true; wait "${_wd}" 2>/dev/null || true
    fi
    ;;
  *)
    echo "usage: bash --schema | --describe | --exec" >&2
    exit 1
    ;;
esac
