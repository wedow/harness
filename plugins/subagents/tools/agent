#!/usr/bin/env bash
# agent — tool plugin: spawn a subagent to handle a task autonomously.
set -euo pipefail

# _schema_error CAND SCHEMA — exit 0 (silent) if CAND is a JSON object whose
# keys include every entry in SCHEMA.required; else print why and exit 1.
_schema_error() {
  local cand="$1" schema="$2" missing
  printf '%s' "${cand}" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || { echo "not a JSON object"; return 1; }
  missing="$(printf '%s' "${cand}" | jq -c --argjson s "${schema}" '($s.required // []) - keys')" \
    || { echo "invalid JSON"; return 1; }
  [[ "${missing}" == "[]" ]] || { echo "missing required keys ${missing}"; return 1; }
}

# _run_child_or_fail ASK — run the subagent (cd workdir, env overrides,
# HARNESS_AGENT_TIMEOUT wall-clock cap, stderr captured rather than discarded).
# On a hard failure (non-zero child exit, timeout, or no usable output) prints
# a marked error and exits non-zero so tool_exec flags error:true. Otherwise
# leaves the child's stdout in _child_out for the caller to use.
_run_child_or_fail() {
  local ask="$1" err_file last_err
  err_file="$(mktemp)"
  _child_exit=0
  _child_out="$(cd "${workdir}" && timeout "${HARNESS_AGENT_TIMEOUT:-600}" \
    env ${env_args[@]+"${env_args[@]}"} "${HARNESS_ROOT}/bin/harness" agent "${ask}" \
    2>"${err_file}")" || _child_exit=$?
  _child_err="$(cat "${err_file}")"
  rm -f "${err_file}"
  if [[ "${_child_exit}" -ne 0 || -z "${_child_out}" ]]; then
    last_err="$(printf '%s\n' "${_child_err}" | tail -1)"
    if [[ "${_child_exit}" -eq 124 ]]; then
      printf 'subagent timed out after %ss: %s\n' "${HARNESS_AGENT_TIMEOUT:-600}" "${last_err}"
    else
      printf 'subagent failed (exit %d): %s\n' "${_child_exit}" "${last_err}"
    fi
    exit 1
  fi
}

case "${1:-}" in
  --schema)
    cat <<'JSON'
{
  "name": "agent",
  "description": "Spawn a subagent to handle a complex or independent task. The subagent runs a full agent loop with its own session, then returns its final output. Use for tasks that benefit from focused, isolated execution.",
  "input_schema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "The task for the subagent to perform. Be specific — include context, expected output, and constraints."
      },
      "model": {
        "type": "string",
        "description": "Model override (optional, defaults to the provider's default model)"
      },
      "provider": {
        "type": "string",
        "description": "Provider override (optional, defaults to parent's provider)"
      },
      "schema": {
        "type": "object",
        "description": "Optional JSON Schema. When set, the subagent is told to return only a JSON object matching it; the tool extracts that object (stripping any code fence), checks every required key is present, retries on mismatch, and returns compact validated JSON instead of prose."
      }
    },
    "required": ["prompt"]
  }
}
JSON
    ;;
  --describe)
    echo "Spawn a subagent to handle a task"
    ;;
  --exec)
    depth="${HARNESS_DEPTH:-0}"
    max_depth="${RLM_MAX_DEPTH:-2}"
    [[ "${depth}" =~ ^[0-9]+$ ]] \
      || { echo "agent: HARNESS_DEPTH must be a non-negative integer" >&2; exit 1; }
    [[ "${max_depth}" =~ ^[0-9]+$ ]] \
      || { echo "agent: RLM_MAX_DEPTH must be a non-negative integer" >&2; exit 1; }
    depth=$(( 10#${depth} )); max_depth=$(( 10#${max_depth} ))
    if (( depth >= max_depth )); then
      echo "agent: delegation depth ${depth} reached maximum ${max_depth}" >&2
      exit 1
    fi

    agent_session_root="${HARNESS_AGENT_SESSION_ROOT:-${HARNESS_SESSION:-}}"
    input="$(cat)"
    prompt="$(echo "${input}" | jq -r '.prompt')"
    model="$(echo "${input}" | jq -r '.model // empty')"
    provider="$(echo "${input}" | jq -r '.provider // empty')"
    schema="$(echo "${input}" | jq -c '.schema // empty')"
    validation_schema="${schema}"
    if [[ -n "${schema}" && "$(echo "${schema}" | jq -r '.type // empty')" == "json_schema" ]]; then
      validation_schema="$(echo "${schema}" | jq -c '.schema')"
    fi

    # Build env overrides
    env_args=()
    [[ -n "${model}" ]]    && env_args+=(HARNESS_MODEL="${model}")
    [[ -n "${provider}" ]] && env_args+=(HARNESS_PROVIDER="${provider}")

    # Nest subagent sessions under the current agent's session dir
    if [[ -n "${HARNESS_SESSION:-}" ]]; then
      env_args+=(HARNESS_SESSIONS="${HARNESS_SESSION}/.harness/sessions")
      env_args+=(HARNESS_PARENT_SESSION="${HARNESS_SESSION##*/}")
      env_args+=(HARNESS_DEPTH="$(( ${HARNESS_DEPTH:-0} + 1 ))")
      env_args+=(HARNESS_AGENT_SESSION_ROOT="${agent_session_root:-${HARNESS_SESSION}}")
    fi

    workdir="${HARNESS_CWD:-${PWD}}"

    if [[ -n "${schema}" ]]; then
      # --- structured-output mode (headless): instruct the subagent to emit raw
      # JSON, extract it, check required keys, retry on mismatch, emit compact. ---
      instr=$'\n\n'"Return ONLY a single JSON object that satisfies this JSON Schema. Output raw JSON with no prose and no code fence:"$'\n'"${validation_schema}"
      ask="${prompt}${instr}"; result=""; raw=""; tries=0
      while (( tries++ < "${HARNESS_AGENT_SCHEMA_RETRIES:-3}" )); do
        _run_child_or_fail "${ask}"
        raw="${_child_out}"
        cand="$(printf '%s' "${raw}" | sed -n '/^```/,/^```/{/^```/d;p;}')"
        [[ -n "${cand}" ]] || cand="${raw}"
        if err="$(_schema_error "${cand}" "${validation_schema}")"; then
          result="$(printf '%s' "${cand}" | jq -c .)"; break
        fi
        ask="${prompt}${instr}"$'\n\n'"Your previous reply was invalid (${err}). Return ONLY the JSON object, nothing else."
      done
      printf '%s\n' "${result:-${raw:-subagent completed with no output}}"

    # --- tmux: spawn subagent in a sibling pane ---
    elif [[ -n "${TMUX:-}" && -n "${HARNESS_SESSION:-}" ]]; then
      # Resolve nested sessions dir
      sessions_dir="${HARNESS_SESSION}/.harness/sessions"

      # Create subagent session dir upfront so we can read results
      session_id="$(date +%Y%m%d-%H%M%S)-$$"
      session_dir="${sessions_dir}/${session_id}"
      mkdir -p "${session_dir}/messages"
      cat > "${session_dir}/session.conf" <<CONF
id=${session_id}
model=${model:-${HARNESS_MODEL:-}}
provider=${provider:-${HARNESS_PROVIDER:-}}
created=$(date -Iseconds)
cwd=${workdir}
parent=${HARNESS_SESSION##*/}
CONF

      # Save user message (frontmatter + prompt)
      seq="0001"
      {
        cat <<HEADER
---
role: user
seq: ${seq}
timestamp: $(date -Iseconds)
---
HEADER
        printf '%s\n' "${prompt}"
      } > "${session_dir}/messages/${seq}-user.md"

      # Build a shell-safe command for the tmux pane.
      printf -v q_workdir %q "${workdir}"
      printf -v q_sessions_dir %q "${sessions_dir}"
      printf -v q_parent_session %q "${HARNESS_SESSION##*/}"
      printf -v q_session_dir %q "${session_dir}"
      printf -v q_harness %q "${HARNESS_ROOT}/bin/harness"
      printf -v q_session_id %q "${session_id}"
      printf -v q_exit_code_file %q "${session_dir}/.exit_code"
      printf -v q_started_file %q "${session_dir}/.started"
      # Always export provider/model so the fresh tmux shell inherits the
      # parent's resolve stage (inline/schema branches get this for free).
      printf -v q_model %q "${model:-${HARNESS_MODEL:-}}"
      printf -v q_provider %q "${provider:-${HARNESS_PROVIDER:-}}"
      env_export="HARNESS_SESSIONS=${q_sessions_dir}"
      env_export+=" HARNESS_PARENT_SESSION=${q_parent_session}"
      env_export+=" HARNESS_SESSION=${q_session_dir}"
      env_export+=" HARNESS_MODEL=${q_model}"
      env_export+=" HARNESS_PROVIDER=${q_provider}"
      env_export+=" HARNESS_DEPTH=$(( ${HARNESS_DEPTH:-0} + 1 ))"
      printf -v q_agent_session_root %q "${agent_session_root:-${HARNESS_SESSION}}"
      env_export+=" HARNESS_AGENT_SESSION_ROOT=${q_agent_session_root}"
      printf -v q_agent_concurrency %q "${HARNESS_AGENT_CONCURRENCY:-4}"
      env_export+=" HARNESS_AGENT_CONCURRENCY=${q_agent_concurrency}"
      printf -v q_max_depth %q "${RLM_MAX_DEPTH:-2}"
      env_export+=" RLM_MAX_DEPTH=${q_max_depth}"
      printf -v q_run_id %q "${HARNESS_RUN_ID:-}"
      env_export+=" HARNESS_RUN_ID=${q_run_id}"

      # The pane touches .started before running harness, then writes harness
      # stream's exit code to .exit_code on return. The pair lets the parent
      # distinguish "pane ran but was killed externally" (started, no exit_code)
      # from "pane never ran" (test fakes that capture the cmd without running).
      pane_cmd="cd ${q_workdir} && touch ${q_started_file} && ${env_export} ${q_harness} stream ${q_session_id} < /dev/null; printf '%s' \$? > ${q_exit_code_file}"
      # Spawn in a new pane; spill to a new window if this one is too full to
      # split, then retile into an even grid so panes don't squish to death.
      pane_id="$(tmux split-window -P -F '#{pane_id}' "${pane_cmd}" 2>/dev/null)" \
        || pane_id="$(tmux new-window -P -F '#{pane_id}' "${pane_cmd}")"
      tmux select-layout -t "${pane_id}" tiled >/dev/null 2>&1 || true
      # Bound the pane-poll loop by the wall-clock timeout; kill the pane on
      # expiry so a hung subagent doesn't block the parent until manually killed.
      deadline=$(( $(date +%s) + ${HARNESS_AGENT_TIMEOUT:-600} ))
      while tmux list-panes -t "${pane_id}" &>/dev/null; do
        if (( $(date +%s) >= deadline )); then
          tmux kill-pane -t "${pane_id}" 2>/dev/null || true
          echo "subagent timed out after ${HARNESS_AGENT_TIMEOUT:-600}s"
          exit 1
        fi
        sleep 0.2
      done

      # Pane started but was killed externally (user closed it, OOM, kill -9,
      # tmux restart) before harness could return and write .exit_code. Without
      # this check the fall-through emits "completed with no output" exit 0 —
      # the BUG-1 silent-failure mode.
      if [[ ! -f "${session_dir}/.exit_code" && -f "${session_dir}/.started" ]]; then
        echo "subagent pane closed unexpectedly (no exit marker)"
        exit 1
      fi

      # If the pane wrote a non-zero exit code, surface it (BUG-1 for tmux).
      if [[ -f "${session_dir}/.exit_code" ]]; then
        child_exit="$(cat "${session_dir}/.exit_code")"
        if [[ "${child_exit}" != "0" ]]; then
          echo "subagent failed (exit ${child_exit:-unknown})"
          exit 1
        fi
      fi

      # Read the last assistant message body from the session
      # Strip frontmatter and thinking blocks to match original output format
      last_asst="$(find "${session_dir}/messages" -maxdepth 1 -type f -name '*-assistant.md' -printf '%f\n' 2>/dev/null | sort -n | tail -1)"
      if [[ -n "${last_asst}" ]]; then
        result="$(awk 'BEGIN{f=0} /^---/{f++; next} f>=2' "${session_dir}/messages/${last_asst}" | sed '1{/^$/d}' | awk '/^```thinking/{skip=1; next} skip && /^```$/{skip=0; next} !skip')"
      else
        result=""
      fi

      if [[ -z "${result}" ]]; then
        echo "subagent completed with no output"
      else
        echo "${result}"
      fi
    else
      # --- no tmux: run inline (original behavior) ---
      _run_child_or_fail "${prompt}"
      echo "${_child_out}"
    fi
    ;;

  *)
    echo "usage: agent --schema | --describe | --exec" >&2
    exit 1
    ;;
esac
