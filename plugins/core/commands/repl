#!/usr/bin/env bash
# repl — interactive agent session
set -euo pipefail

case "${1:-}" in --describe) echo "interactive agent REPL"; exit 0 ;; esac

source "${HARNESS_ROOT}/bin/harness"
source "${HARNESS_ROOT}/plugins/core/lib/session.sh"
source "${HARNESS_ROOT}/plugins/core/lib/stream-renderer.sh"

# --- Provider resolution (same as agent command) ---
_refresh_sources
_resolve="$(jq -n --arg p "${HARNESS_PROVIDER}" --arg m "${HARNESS_MODEL}" \
  '{provider: $p, model: $m}' | call resolve)" || {
  _err="$(echo "${_resolve}" | jq -r '.error // empty' 2>/dev/null)" || true
  _die "${_err:-provider resolution failed}"
}
HARNESS_PROVIDER="$(echo "${_resolve}" | jq -r '.provider // empty')"
HARNESS_MODEL="$(echo "${_resolve}" | jq -r '.model // empty')"
export HARNESS_PROVIDER HARNESS_MODEL

# --- Session setup ---
session_dir=""
if [[ -n "${1:-}" && -d "${HARNESS_SESSIONS}/${1}" ]]; then
  session_dir="${HARNESS_SESSIONS}/${1}"
  shift
fi
if [[ -z "${session_dir}" ]]; then
  session_dir="$(_new_session)"
fi
export SESSION_DIR="${session_dir}" HARNESS_SESSION="${session_dir}"

echo "session: $(basename "${session_dir}")" >&2
[[ -n "${HARNESS_PROVIDER}" ]] && echo "provider: ${HARNESS_PROVIDER}" >&2
[[ -n "${HARNESS_MODEL}" ]] && echo "model: ${HARNESS_MODEL}" >&2

# --- Stream renderer sourced from lib/stream-renderer.sh ---

_render_history() {
  local msg_dir="${session_dir}/messages"
  [[ -d "${msg_dir}" ]] || return 0

  find "${msg_dir}" -maxdepth 1 -type f -name '*.md' | sort | xargs -r awk '
    function reset_msg() {
      role = ""
      tool = ""
      body = ""
      preview = ""
      in_tool_call = 0
      tool_name = ""
      tool_json = ""
      body_lines = 0
      skipped_blank = 0
      frontmatter = 0
    }

    function append_body(line) {
      body_lines++
      body = body line "\n"
      if (role == "tool_result" && body_lines <= 10) preview = preview line "\n"
    }

    function shell_quote(text) {
      gsub(/\047/, "\047\\\047\047", text)
      return "\047" text "\047"
    }

    function summarize_tool_json(json,  cmd, summary) {
      cmd = "printf %s " shell_quote(json) " | jq -r " shell_quote("to_entries | map(.key + \"=\" + (if (.value|type) == \"string\" then (if (.value|length) > 80 then \"<\" + (.value|length|tostring) + \" chars>\" else .value end) elif (.value|type) == \"array\" then \"<\" + (.value|length|tostring) + \" items>\" elif (.value|type) == \"object\" then \"<object>\" else (.value|tostring) end)) | join(\" \")") " 2>/dev/null"
      cmd | getline summary
      close(cmd)
      return summary
    }

    function append_tool_call(  summary) {
      summary = summarize_tool_json(tool_json)
      append_body("\033[90m[tool: " tool_name "]\033[0m" (summary ? " " summary : ""))
    }

    function emit_msg(  label, visible, omitted, out) {
      if (in_tool_call) append_tool_call()
      if (body_lines == 0) return

      if (role == "user") label = "You"
      else if (role == "assistant") label = "Agent"
      else if (role == "tool_result") label = "Tool" (tool ? ": " tool : "")
      else label = role ? role : "Message"

      printf "\n\033[1;36m%s:\033[0m\n", label
      if (role == "tool_result") {
        visible = body_lines < 10 ? body_lines : 10
        printf "%s", preview
        omitted = body_lines - visible
        if (omitted > 0) printf "[... %d lines omitted]\n", omitted
      } else {
        out = body
        sub(/\n+$/, "", out)
        printf "%s\n", out
      }
    }

    FNR == 1 {
      if (NR > 1) emit_msg()
      reset_msg()
    }

    frontmatter < 2 && $0 == "---" {
      frontmatter++
      next
    }

    frontmatter < 2 {
      if ($0 ~ /^role: /) role = substr($0, 7)
      else if ($0 ~ /^tool: /) tool = substr($0, 7)
      next
    }

    !skipped_blank && $0 == "" {
      skipped_blank = 1
      next
    }

    {
      skipped_blank = 1
      if (role == "assistant" && in_tool_call && $0 == "```") {
        append_tool_call()
        in_tool_call = 0
        tool_name = ""
        tool_json = ""
        next
      }
      if (role == "assistant" && in_tool_call) {
        tool_json = tool_json $0 "\n"
        next
      }
      if (role == "assistant" && $0 ~ /^```tool_call /) {
        in_tool_call = 1
        tool_name = $0
        sub(/^.* name=/, "", tool_name)
        sub(/ .*$/, "", tool_name)
        next
      }
      append_body($0)
    }

    END { emit_msg() }
  '
}

if [[ "${HARNESS_PRINT_HISTORY:-}" == "1" ]]; then
  _render_history
fi

# --- REPL loop ---
# Redirect hook logs to file so they don't interleave with stream output
export HARNESS_LOG="${session_dir}/repl.log"
touch "${session_dir}/.stream"

agent_pid=""
interrupts=0
# With `set -m`, agent_pid is also the process group id.
_kill_group() { [[ -n "${agent_pid}" ]] && kill -TERM -- "-${agent_pid}" 2>/dev/null || true; }
_hard_kill()  { [[ -n "${agent_pid}" ]] && kill -KILL -- "-${agent_pid}" 2>/dev/null || true; }
_handle_sigint() {
  interrupts=$((interrupts + 1))
  if (( interrupts >= 2 )); then
    _hard_kill
    trap - EXIT HUP TERM INT
    # `0` targets our own process group so the stream tail (started in
    # _render_stream, in repl's pgid not the agent's) is killed too.
    exec kill -KILL 0
  fi
  _kill_group
}
_frontmatter_value() {
  local key="$1" file="$2"
  awk -F': ' -v key="${key}" '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && $1 == key { print $2; exit }
  ' "${file}"
}

_print_session_stats() {
  local msg_dir="${session_dir}/messages"
  [[ -d "${msg_dir}" ]] || return 0

  local tokens_in=0 tokens_out=0 tokens_total=0 cache_read=0 cache_write=0
  local file in_count out_count total_count read_count write_count
  while IFS= read -r file; do
    in_count="$(_frontmatter_value tokens_in "${file}")"
    out_count="$(_frontmatter_value tokens_out "${file}")"
    total_count="$(_frontmatter_value tokens_total "${file}")"
    read_count="$(_frontmatter_value tokens_cache_read "${file}")"
    write_count="$(_frontmatter_value tokens_cache_write "${file}")"

    in_count="${in_count:-0}"
    out_count="${out_count:-0}"
    total_count="${total_count:-$(( in_count + out_count ))}"
    read_count="${read_count:-0}"
    write_count="${write_count:-0}"

    tokens_in=$(( tokens_in + in_count ))
    tokens_out=$(( tokens_out + out_count ))
    tokens_total=$(( tokens_total + total_count ))
    cache_read=$(( cache_read + read_count ))
    cache_write=$(( cache_write + write_count ))
  done < <(find "${msg_dir}" -maxdepth 1 -type f -name '*-assistant.md' | sort)

  (( tokens_total == 0 && tokens_in == 0 && tokens_out == 0 )) && return 0
  echo "Token usage: total=${tokens_total} input=${tokens_in} (+ ${cache_read} cached, + ${cache_write} written) output=${tokens_out}" >&2
}

_print_resume_instructions() {
  _print_session_stats
  echo "To continue this session, run harness resume $(basename "${session_dir}")" >&2
}
_cleanup_repl() {
  _kill_group
  wait 2>/dev/null || true
  _print_resume_instructions
}
trap _cleanup_repl EXIT HUP TERM
trap _handle_sigint INT

while true; do
  printf '\n\033[1;36mYou:\033[0m '
  IFS= read -r input || break
  interrupts=0
  [[ -z "${input}" ]] && continue
  [[ "${input}" == "/quit" || "${input}" == "/exit" ]] && break
  [[ "${input}" == "/session" ]] && { echo "${session_dir}"; continue; }

  _save_message "${session_dir}" "${input}"
  printf '\033[1;33mAgent:\033[0m '

  > "${session_dir}/.stream"

  set -m
  agent_loop "${session_dir}" >/dev/null &
  agent_pid=$!
  set +m
  _render_stream "${session_dir}/.stream" "${agent_pid}"
  wait "${agent_pid}" 2>/dev/null || true
  agent_pid=""
  echo
done
