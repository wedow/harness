#!/usr/bin/env bash
# 10-tool-path — build .tool-bin/ with symlinks to discovered tools, export HARNESS_TOOL_PATH.
set -euo pipefail
input="$(cat)"

[[ -n "${HARNESS_SESSION:-}" && -n "${HARNESS_SOURCES:-}" ]] || { echo "${input}"; exit 0; }

tool_bin="${HARNESS_SESSION}/.tool-bin"
mkdir -p "${tool_bin}"

# Walk sources lowest-to-highest priority; later wins (same dedup as 20-tools)
IFS=':' read -ra sources <<< "${HARNESS_SOURCES}"
declare -A tool_map
for src in "${sources[@]}"; do
  [[ -d "${src}/tools" ]] || continue
  for f in "${src}/tools"/*; do
    [[ -x "${f}" ]] || continue
    name="$(basename "${f}")"
    tool_map["${name}"]="$(realpath "${f}")"
  done
done

# Create symlinks (skip 'bash' — it shadows /usr/bin/bash via #!/usr/bin/env bash shebangs)
for name in "${!tool_map[@]}"; do
  [[ "${name}" == "bash" ]] && continue
  ln -sf "${tool_map[$name]}" "${tool_bin}/${name}"
done

export HARNESS_TOOL_PATH="${tool_bin}"

# Persist for downstream hooks/tools in this session
echo "HARNESS_TOOL_PATH=${tool_bin}" >> "${HARNESS_SESSION}/session.conf"

echo "${input}"
