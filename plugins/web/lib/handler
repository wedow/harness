#!/usr/bin/env bash
# handler — per-connection HTTP entry point. stdin/stdout is the socket.
# Sourced environment: HARNESS_ROOT, HARNESS_SESSIONS (set by serve).
set -uo pipefail

# Timestamp every stderr line (including bash's own diagnostics like
# "printf: write error: Broken pipe") so connection-log noise is
# correlatable with events in other logs.
# fd 9 = the real stderr: the timestamper must keep writing there even
# when the socket (stdout) is broken — that is exactly when the noise happens.
exec 9>&2
exec 2> >(
  while IFS= read -r line; do
    printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "${line}" >&9
  done
)

source "${HARNESS_ROOT}/plugins/web/lib/http.sh"
source "${HARNESS_ROOT}/plugins/core/lib/session.sh"
source "${HARNESS_ROOT}/plugins/web/lib/pages.sh"

# ------------------------------------------------------------------ parse --
METHOD="" RPATH="" BODY=""
declare -A HTTP_HEADERS=()

read -r -t 10 -a REQ_LINE || { exit 0; }
METHOD="${REQ_LINE[0]:-}"
RPATH="${REQ_LINE[1]:-/}"
RPATH="${RPATH%%\?*}" # strip query string
while IFS= read -r -t 10 h; do
  h="${h%$'\r'}"; [[ -z "${h}" ]] && break
  key="${h%%:*}"; HTTP_HEADERS["${key,,}"]="${h#*: }"
done
# The server listens on loopback, but DNS rebinding can still give it a
# foreign Host. Check every method, including transcript reads over GET.
host="${HTTP_HEADERS[host]:-}"
host="${host,,}"
if [[ ! "${host}" =~ ^(127\.0\.0\.1|localhost)(:[0-9]{1,5})?$ ]]; then
  STATUS=403; HEADERS=("Content-Type: text/plain"); BODY="forbidden host"
  respond_request; exit 0
fi
if [[ "${METHOD}" == "POST" ]]; then
  # Browsers can send cross-origin forms to loopback. Reject them before any
  # state-changing route runs. Local HTTP clients may omit Origin.
  origin="${HTTP_HEADERS[origin]:-}"
  fetch_site="${HTTP_HEADERS[sec-fetch-site]:-}"
  if { [[ -n "${origin}" ]] && [[ "${origin}" != "http://${host}" ]]; } ||
     { [[ -z "${origin}" && -n "${fetch_site}" ]] &&
       [[ "${fetch_site}" != "same-origin" && "${fetch_site}" != "none" ]]; }; then
    STATUS=403; HEADERS=("Content-Type: text/plain"); BODY="forbidden origin"
    respond_request; exit 0
  fi
  clen="${HTTP_HEADERS[content-length]:-0}"
  # Bash recursively evaluates variable values in arithmetic contexts. A
  # header such as BODY[$(command)] must never reach an arithmetic expression.
  if [[ ! "${clen}" =~ ^[0-9]+$ ]]; then
    STATUS=400; HEADERS=("Content-Type: text/plain"); BODY="invalid Content-Length"
    respond_request; exit 0
  fi
  if [[ "${#clen}" -gt 7 ]] || (( 10#$clen > 1048576 )); then
    STATUS=413; HEADERS=("Content-Type: text/plain"); BODY="request body too large"
    respond_request; exit 0
  fi
  clen=$((10#$clen))
  (( clen > 0 )) && IFS= read -r -N "${clen}" -t 30 BODY || true
fi

# ------------------------------------------------------------------ route --
case "${METHOD}" in
  GET)
    if [[ "${RPATH}" == "/" ]]; then handle_home
    elif [[ "${RPATH}" == "/datastar.js" ]]; then handle_asset datastar.js
    elif [[ "${RPATH}" =~ ^/s/([^/]+)/events$ ]]; then handle_events "${BASH_REMATCH[1]}"
    elif [[ "${RPATH}" =~ ^/s/([^/]+)$ ]]; then handle_session "${BASH_REMATCH[1]}"
    else handle_404; fi ;;
  POST)
    if [[ "${RPATH}" == "/new" ]]; then handle_new
    elif [[ "${RPATH}" =~ ^/s/([^/]+)/stop$ ]]; then handle_stop "${BASH_REMATCH[1]}"
    elif [[ "${RPATH}" =~ ^/s/([^/]+)/retry$ ]]; then handle_retry "${BASH_REMATCH[1]}"
    elif [[ "${RPATH}" =~ ^/s/([^/]+)$ ]]; then handle_send "${BASH_REMATCH[1]}"
    else handle_404; fi ;;
  *) handle_404 ;;
esac

respond_request
