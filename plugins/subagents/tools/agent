#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  --schema)
    cat <<'JSON'
{"name":"agent","description":"Start an independent background agent. Returns a job receipt now; the child's final report arrives later as a work observation.","input_schema":{"type":"object","properties":{"name":{"type":"string","description":"Short name for this assignment; use it later with zoom."},"prompt":{"type":"string","description":"Task, expected report, context and constraints."},"cwd":{"type":"string","description":"Optional working directory, defaults to the parent's."}},"required":["name","prompt"],"additionalProperties":false}}
JSON
    ;;
  --describe) printf 'Start a background agent\n' ;;
  --exec) printf 'agent is dispatched by the reactor, not a standalone executable\n' >&2; exit 1 ;;
  *) exit 1 ;;
esac
