#!/usr/bin/env bash
# 25-compact — archive-based compaction. When total message content exceeds
# RLM_COMPACT_TOTAL (default 200000 chars), archives the current messages dir
# and injects a continuation message. Signals reassembly via next_state=assemble.
set -euo pipefail

payload="$(cat)"

session="${HARNESS_SESSION:-}"
[[ -n "${session}" && -d "${session}/messages" ]] || { echo "${payload}"; exit 0; }

total_threshold="${RLM_COMPACT_TOTAL:-200000}"
msg_dir="${session}/messages"

# Estimate total content size from message files on disk
total_size=0
for f in "${msg_dir}"/*.md; do
  [[ -f "${f}" ]] || continue
  size="$(wc -c < "${f}")"
  total_size=$((total_size + size))
done

if (( total_size < total_threshold )); then
  echo "${payload}"
  exit 0
fi

# Archive current messages
ts="$(date +%s)"
archive_dir="${session}/archives/${ts}"
mkdir -p "${archive_dir}"
mv "${msg_dir}" "${archive_dir}/messages"
mkdir -p "${msg_dir}"

# Write continuation message
cat > "${msg_dir}/0001-user.md" <<EOF
---
role: user
seq: 0001
timestamp: $(date -Iseconds)
---
[Session continuation after compaction]

The previous conversation exceeded the context threshold and was archived.
Archives are at ${session}/archives/ (most recent: ${ts}).

Do not continue the prior task from memory or guesswork. Your first action MUST be archive recovery using subagents.

Required recovery protocol:
1. Spawn one or more subagents to inspect the archived messages under ${session}/archives/${ts}/messages/.
2. Have the subagents produce an ultra-slim recovery summary plus an index of the most important archived regions.
3. The index must include citations to specific archive message files, and line ranges when useful, so you can tendril back into the archive for details instead of relying on a lossy summary.
4. Recover at minimum: active objective, active skill/workflow in progress, whether any skill must be reinvoked to continue cleanly, completed steps, pending next action, relevant files/tickets/commands, blockers or failures, and decisions already made.
5. If an active skill was in progress, reinvoke/load that skill before resuming its workflow, then follow its instructions from the recovered state.
6. Write the recovered state to ${session}/notes/post-compaction-recovery.md.

Only after that recovery note exists should you resume the task. Use additional subagent archive queries whenever the summary is insufficient.
EOF

# Signal reassembly — the assemble pipeline will re-run with fresh messages
printf '{"next_state": "assemble"}\n'
