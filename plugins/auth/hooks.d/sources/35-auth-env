#!/usr/bin/env bash
# 35-auth-env — merge .auth.json from discovered sources into a cache for providers
set -euo pipefail

source "${HARNESS_ROOT}/lib/provider.sh"
input="$(cat)"
export HARNESS_SOURCES="$(printf '%s' "${input}" | jq -r '.sources | join(":")')"
harness_auth_refresh
printf '%s\n' "${input}"
