#!/usr/bin/env bash
# 10-save — parse Anthropic response, save canonical message, return control JSON.
# Receives raw Anthropic API response JSON on stdin.
set -euo pipefail

response="$(cat)"
msg_dir="${HARNESS_SESSION}/messages"
[[ -d "${msg_dir}" ]] || exit 0

# Reserve a sequence shared with web inserts and other message writers.
source "${HARNESS_ROOT}/plugins/core/lib/session.sh"
seq="$(_claim_message_seq "${HARNESS_SESSION}")"

# Extract metadata
model="$(echo "${response}" | jq -r '.model // ""')"
stop_reason="$(echo "${response}" | jq -r '.stop_reason // "end_turn"')"
input_tokens="$(echo "${response}" | jq -r '.usage.input_tokens // 0')"
output_tokens="$(echo "${response}" | jq -r '.usage.output_tokens // 0')"
total_tokens=$(( input_tokens + output_tokens ))
cache_read_tokens="$(echo "${response}" | jq -r '.usage.cache_read_input_tokens // 0')"
cache_write_tokens="$(echo "${response}" | jq -r '.usage.cache_creation_input_tokens // 0')"

# Normalize stop_reason to canonical stop field
case "${stop_reason}" in
  end_turn)   stop="end" ;;
  tool_use)   stop="tool_calls" ;;
  max_tokens) stop="length" ;;
  *)          stop="${stop_reason}" ;;
esac

# Build the markdown body from content blocks
body=""
text_output=""
tool_items="[]"
content_blocks="$(echo "${response}" | jq -c '.content[]')"

# Fence length for a block body: one past the longest backtick run at a
# line start (min 3). A fence that cannot appear in content means an
# embedded ``` inside thinking can never terminate the block early —
# markdown's growing-fence rule.
_fence_len() { # $1 = block text -> $_fence (N backticks)
  local max=2 run line
  while IFS= read -r line; do
    [[ "${line}" =~ ^(\`+) ]] || continue
    run="${#BASH_REMATCH[1]}"
    (( run > max )) && max="${run}"
  done <<< "$1"
  _fence="$(printf '%*s' $(( max + 1 )) '' | tr ' ' '\`')"
}
while IFS= read -r block; do
  [[ -z "${block}" ]] && continue
  btype="$(echo "${block}" | jq -r '.type')"
  case "${btype}" in
    text)
      text="$(echo "${block}" | jq -r '.text')"
      body+="${text}"$'\n'
      text_output+="${text}"
      ;;
    thinking)
      tsig="$(echo "${block}" | jq -r '.signature')"
      ttext="$(echo "${block}" | jq -r '.thinking')"
      _fence_len "${ttext}"
      body+="${_fence}thinking signature=${tsig}"$'\n'
      body+="${ttext}"$'\n'
      body+="${_fence}"$'\n'
      ;;
    tool_use)
      tid="$(echo "${block}" | jq -r '.id')"
      tname="$(echo "${block}" | jq -r '.name')"
      tinput="$(echo "${block}" | jq -c '.input')"
      body+=$'\n'"\`\`\`tool_call id=${tid} name=${tname}"$'\n'
      body+="${tinput}"$'\n'
      body+='```'$'\n'
      tool_items="$(printf '%s\n%s' "${tool_items}" "${tinput}" \
        | jq -s --arg id "${tid}" --arg name "${tname}" \
        '.[0] + [{id: $id, name: $name, input: .[1]}]')"
      ;;
  esac
done <<< "${content_blocks}"

# Write the canonical message file
cat > "${msg_dir}/${seq}-assistant.md" <<EOF
---
role: assistant
seq: ${seq}
timestamp: $(date -Iseconds)
model: ${model}
provider: ${HARNESS_PROVIDER}
stop: ${stop}
tokens_in: ${input_tokens}
tokens_out: ${output_tokens}
tokens_total: ${total_tokens}
tokens_cache_read: ${cache_read_tokens}
tokens_cache_write: ${cache_write_tokens}
---
${body}
EOF

[[ -n "${HARNESS_SESSION:-}" ]] && printf '%s\n' "$(jq -c -n --arg s "${stop}" --arg seq "${seq}" '{type:"stop",reason:$s,seq:$seq}')" >> "${HARNESS_SESSION}/.stream"

# Return control JSON — stop:length continuation lives in the shared lib
source "${HARNESS_ROOT}/plugins/core/lib/continue.sh"
if [[ "${stop}" == "tool_calls" ]]; then
  _length_cont_reset  # fresh turn
  echo "${tool_items}" | jq '{next_state: "tool_exec", tool_calls: .}'
elif [[ "${stop}" == "length" ]]; then
  _length_continue "${msg_dir}"
else
  _length_cont_reset  # turn complete
  printf '%s' "${text_output}" | jq -Rs '{next_state: "done", output: .}'
fi
