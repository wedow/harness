#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  --schema)
    cat <<'JSON'
{"name":"bash","description":"Run a Bash command in the working directory as a background job. Its observation contains JSON {exit,elapsed_s,timed_out,stdout,stderr}.","input_schema":{"type":"object","properties":{"command":{"type":"string"},"timeout":{"type":"integer","minimum":1,"maximum":600,"description":"Seconds, default 120."},"intent":{"type":"string","description":"Short explanation for the user."}},"required":["command"]}}
JSON
    ;;
  --describe) printf 'Execute bash commands\n' ;;
  --exec)
    source "${HARNESS_ROOT}/lib/bootstrap.sh"
    input="$(cat)"
    printf '%s' "${input}" | jq -e '(.command|type)=="string" and (.command|length)>0 and ((.timeout // 120)|type)=="number" and ((.timeout // 120)|floor)==(.timeout // 120) and (.timeout // 120)>=1 and (.timeout // 120)<=600' >/dev/null || exit 1
    command="$(printf '%s' "${input}" | jq -r '.command')"; seconds="$(printf '%s' "${input}" | jq -r '.timeout // 120')"
    cd "${HARNESS_CWD:-${PWD}}"
    temp="$(mktemp -d)"; child=""
    trap 'trap "" TERM INT; if [[ -n "${child}" ]]; then terminate_group "${child}"; wait "${child}" 2>/dev/null || true; fi; rm -rf "${temp}"' EXIT
    trap 'trap "" TERM INT; exit 143' TERM INT
    started="$(date +%s.%N)"; rc=0
    if [[ "${HARNESS_JOB_MANAGED:-}" == 1 ]]; then
      # The job runner already owns and bounds this entire process group.
      bash -c "${command}" >"${temp}/stdout" 2>"${temp}/stderr" || rc=$?
    else
      setsid timeout --kill-after=5 "${seconds}" bash -c "${command}" >"${temp}/stdout" 2>"${temp}/stderr" & child=$!
      wait "${child}" || rc=$?
      terminate_group "${child}"; child=""
    fi
    elapsed="$(awk -v a="${started}" -v b="$(date +%s.%N)" 'BEGIN {printf "%.2f",b-a}')"
    jq -cn --argjson rc "${rc}" --argjson elapsed "${elapsed}" --argjson timeout "${seconds}" --rawfile out "${temp}/stdout" --rawfile err "${temp}/stderr" '{exit:$rc,elapsed_s:$elapsed,timeout_s:$timeout,timed_out:($rc==124 or $rc==137),stdout:$out,stderr:$err}'
    (( rc==0 ))
    ;;
  *) exit 1 ;;
esac
