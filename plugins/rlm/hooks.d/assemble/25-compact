#!/usr/bin/env bash
# 25-compact — archive-based compaction. When total message content exceeds
# RLM_COMPACT_TOTAL (default 200000 chars), archives the current messages dir
# and injects a continuation message. Signals reassembly via next_state=assemble.
set -euo pipefail

payload="$(cat)"

session="${HARNESS_SESSION:-}"
[[ -n "${session}" && -d "${session}/messages" ]] || { echo "${payload}"; exit 0; }

total_threshold="${RLM_COMPACT_TOTAL:-200000}"
msg_dir="${session}/messages"

# Estimate total content size from message files on disk
total_size=0
for f in "${msg_dir}"/*.md; do
  [[ -f "${f}" ]] || continue
  size="$(wc -c < "${f}")"
  total_size=$((total_size + size))
done

if (( total_size < total_threshold )); then
  echo "${payload}"
  exit 0
fi

# Archive current messages
ts="$(date +%s)"
archive_dir="${session}/archives/${ts}"
mkdir -p "${archive_dir}"
mv "${msg_dir}" "${archive_dir}/messages"
mkdir -p "${msg_dir}"

# Write continuation message
cat > "${msg_dir}/0001-user.md" <<EOF
---
role: user
seq: 0001
timestamp: $(date -Iseconds)
---
[Session continuation] This session continues from an archived conversation.
Archives are at ${session}/archives/ (most recent: ${ts}).
Use subagents to search archive messages if you need history or context.
Resume the task in progress.
EOF

# Signal reassembly — the assemble pipeline will re-run with fresh messages
printf '{"next_state": "assemble"}\n'
