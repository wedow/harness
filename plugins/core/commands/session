#!/usr/bin/env bash
# harness session — manage sessions (list, show, dir)
set -euo pipefail

case "${1:-}" in
  --describe) echo "manage sessions (list, show, dir)"; exit 0 ;;
esac

source "${HARNESS_ROOT}/bin/harness"

subcmd="${1:-list}"; shift || true
case "${subcmd}" in
  list)
    ls -1t "${HARNESS_SESSIONS}" 2>/dev/null || echo "(no sessions)"
    ;;
  show)
    id="${1:-}"
    [[ -n "${id}" ]] || _die "usage: harness session show <id>"
    dir="${HARNESS_SESSIONS}/${id}"
    [[ -d "${dir}" ]] || _die "session '${id}' not found"
    grep -v '^parent=$' "${dir}/session.conf"
    echo "messages=$(ls -1 "${dir}/messages/" | wc -l | tr -d ' ')"
    ls -1 "${dir}/messages/"
    ;;
  dir)
    id="${1:-}"
    if [[ -n "${id}" ]]; then
      echo "${HARNESS_SESSIONS}/${id}"
    else
      echo "${HARNESS_SESSIONS}"
    fi
    ;;
  title) # harness session title <id> <text...> — sets and locks the title
    id="${1:-}"; shift || true; text="${*:-}"
    [[ -n "${id}" && -n "${text}" ]] || _die "usage: harness session title <id> <text...>"
    conf="${HARNESS_SESSIONS}/${id}/session.conf"
    [[ -f "${conf}" ]] || _die "session '${id}' not found"
    tmp="$(mktemp)"
    awk -v t="${text}" 'BEGIN{tn=0;ln=0}
      /^title=/{print "title=" t; tn=1; next}
      /^title_locked=/{print "title_locked=true"; ln=1; next}
      {print} END{if(!tn)print "title=" t; if(!ln)print "title_locked=true"}' "${conf}" > "${tmp}" && mv "${tmp}" "${conf}"
    echo "title locked: ${text}"
    ;;
  *)
    _die "unknown session command: ${subcmd}"
    ;;
esac
