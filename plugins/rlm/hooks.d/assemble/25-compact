#!/usr/bin/env bash
# 25-compact — truncate large content in older messages, leave breadcrumbs.
# Handles Anthropic, OpenAI, and ChatGPT message formats.
set -euo pipefail

payload="$(cat)"

has_messages="$(echo "${payload}" | jq 'has("messages") and (.messages | length) > 0')"
[[ "${has_messages}" == "true" ]] || { echo "${payload}"; exit 0; }

threshold="${RLM_COMPACT_THRESHOLD:-2000}"
keep="${RLM_KEEP_RECENT:-6}"
session="${HARNESS_SESSION:-}"

echo "${payload}" | jq \
  --argjson thresh "${threshold}" \
  --argjson keep "${keep}" \
  --arg session "${session}" '

def trunc:
  if type == "string" and length > $thresh then
    .[:($thresh / 2 | floor)] +
    "\n\n<!-- truncated (" + (length | tostring) +
    " chars). Full session history: " + $session + "/messages/ -->"
  else . end;

.messages |= (
  (length - $keep) as $cutoff |
  [range(length) as $i | .[$i] |
    if $i >= ([0, $cutoff] | max) then .
    else
      # Anthropic: content array with tool_result / text blocks
      if (.content | type) == "array" then
        .content |= map(
          if .type == "tool_result" and (.content | type) == "string" then
            .content |= trunc
          elif .type == "text" and (.text | type) == "string" then
            .text |= trunc
          else . end
        )
      # OpenAI: role=tool
      elif .role == "tool" and (.content | type) == "string" then
        .content |= trunc
      # ChatGPT: function_call_output
      elif .type == "function_call_output" and (.output | type) == "string" then
        .output |= trunc
      # Any message with large string content
      elif (.content | type) == "string" then
        .content |= trunc
      else . end
    end
  ]
)
'
