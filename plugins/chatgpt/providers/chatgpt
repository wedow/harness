#!/usr/bin/env bash
# chatgpt — provider plugin for the ChatGPT Responses API with OAuth auth.
# Canonical JSON in and normalized JSON out; SSE is buffered privately.
set -euo pipefail

[[ "${1:-}" == "--describe" ]] && { echo "ChatGPT Responses API (OAuth)"; exit 0; }
[[ "${1:-}" == "--ready" ]] && {
  cache="${HARNESS_HOME:-${HOME}/.harness}/.auth-cache.json"
  [[ -f "${cache}" ]] || exit 1
  jq -e '.chatgpt | length > 0' "${cache}" &>/dev/null || exit 1
  access_token="$(jq -r '.chatgpt[0].access_token // empty' "${cache}")"
  [[ -n "${access_token}" ]] || exit 1
  exp="$(jq -r '.chatgpt[0].expires_at // "0"' "${cache}")"
  refresh_token="$(jq -r '.chatgpt[0].refresh_token // empty' "${cache}")"
  [[ -n "${refresh_token}" ]] || [[ "${exp}" == "0" ]] || [[ "$(date +%s)" -lt "${exp}" ]]
  exit $?
}
[[ "${1:-}" == "--defaults" ]] && { echo "model=gpt-5.4"; exit 0; }
[[ "${1:-}" == "--env" ]] && { cat <<'ENVEOF'
CHATGPT_MODEL       model override (gpt-5.4)
CHATGPT_MAX_TOKENS  max response tokens (131072)
ENVEOF
exit 0; }

[[ $# == 0 ]] || { echo 'unsupported provider option' >&2; exit 1; }
source "${HARNESS_ROOT:-$(cd "$(dirname "$0")/../../.." >/dev/null && pwd)}/lib/provider.sh"

cache="${HARNESS_HOME:-${HOME}/.harness}/.auth-cache.json"
[[ -f "${cache}" ]] || { echo "no auth cache — run: hs auth set chatgpt" >&2; exit 1; }
_provider_auth_lock

# Read credentials
access_token="$(jq -r '.chatgpt[0].access_token // empty' "${cache}")"
refresh_token="$(jq -r '.chatgpt[0].refresh_token // empty' "${cache}")"
id_token="$(jq -r '.chatgpt[0].id_token // empty' "${cache}")"
account_id="$(jq -r '.chatgpt[0].account_id // empty' "${cache}")"
expires_at="$(jq -r '.chatgpt[0].expires_at // "0"' "${cache}")"

[[ -z "${access_token}" ]] && { echo "no chatgpt access_token — run: hs auth set chatgpt" >&2; exit 1; }

# Refresh token if expired
now="$(date +%s)"
if [[ -n "${refresh_token}" && "${expires_at}" != "0" && "${now}" -ge "${expires_at}" ]]; then
  token_response="$(curl -sS -X POST "https://auth.openai.com/oauth/token" \
    -H "Content-Type: application/x-www-form-urlencoded" \
    -d "grant_type=refresh_token" \
    -d "refresh_token=${refresh_token}" \
    -d "client_id=app_EMoamEEZ73f0CkXaXp7hrann" \
    --max-time 30)" || { echo "token refresh failed" >&2; exit 1; }

  new_access="$(echo "${token_response}" | jq -r '.access_token // empty')"
  [[ -z "${new_access}" ]] && {
    echo "token refresh failed ($(echo "${token_response}" | jq -r '.error_description // .error.message // .error // "unknown"' 2>/dev/null)) — run: hs auth set chatgpt" >&2
    exit 1
  }

  new_refresh="$(echo "${token_response}" | jq -r '.refresh_token // empty')"
  new_id_token="$(echo "${token_response}" | jq -r '.id_token // empty')"
  expires_in="$(echo "${token_response}" | jq -r '.expires_in // "0"')"

  new_expires_at="0"
  if [[ "${expires_in}" != "0" && "${expires_in}" != "null" ]]; then
    new_expires_at="$(( $(date +%s) + expires_in - 300 ))"
  fi

  # Fall back to id_token JWT expiry if expires_in is unavailable.
  if [[ "${new_expires_at}" == "0" && -n "${new_id_token}" && "${new_id_token}" != "null" ]]; then
    jwt_payload="$(echo "${new_id_token}" | cut -d. -f2 | sed 'y|-_|+/|' | awk '{while(length%4)$0=$0"=";print}' | base64 -d 2>/dev/null)" || true
    if [[ -n "${jwt_payload}" ]]; then
      new_expires_at="$(echo "${jwt_payload}" | jq -r '.exp // "0"' 2>/dev/null)" || new_expires_at="0"
    fi
  fi

  access_token="${new_access}"
  [[ -n "${new_refresh}" && "${new_refresh}" != "null" ]] && refresh_token="${new_refresh}"
  [[ -n "${new_id_token}" && "${new_id_token}" != "null" ]] && id_token="${new_id_token}"

  # Update source .auth.json so the next auth-cache rebuild keeps the refresh.
  IFS=':' read -ra _auth_sources <<< "${HARNESS_SOURCES}"
  auth_file=""
  for _s in "${_auth_sources[@]}"; do
    [[ -f "${_s}/.auth.json" ]] && jq -e '.chatgpt | length > 0' "${_s}/.auth.json" &>/dev/null && auth_file="${_s}/.auth.json"
  done
  if [[ -n "${auth_file}" ]]; then
    updated="$(jq \
      --arg at "${access_token}" \
      --arg rt "${refresh_token}" \
      --arg it "${id_token}" \
      --arg exp "${new_expires_at}" \
      '.chatgpt[0].access_token = $at
       | .chatgpt[0].refresh_token = $rt
       | .chatgpt[0].id_token = $it
       | .chatgpt[0].expires_at = $exp' "${auth_file}")"
    _tmp="$(mktemp "${auth_file}.XXXXXX")"
    echo "${updated}" > "${_tmp}" && chmod 600 "${_tmp}" && mv -f "${_tmp}" "${auth_file}"
  fi

  # Update auth cache for this run.
  updated="$(jq \
    --arg at "${access_token}" \
    --arg rt "${refresh_token}" \
    --arg it "${id_token}" \
    --arg exp "${new_expires_at}" \
    '.chatgpt[0].access_token = $at
     | .chatgpt[0].refresh_token = $rt
     | .chatgpt[0].id_token = $it
     | .chatgpt[0].expires_at = $exp' "${cache}")"
  _tmp="$(mktemp "${cache}.XXXXXX")"
  echo "${updated}" > "${_tmp}" && chmod 600 "${_tmp}" && mv -f "${_tmp}" "${cache}"
  echo "refreshed chatgpt token" >&2
fi
_provider_auth_unlock

payload="$(_provider_validate_request)"
request="$(printf '%s' "${payload}" | jq -ce --arg model "${HARNESS_MODEL:-}" --argjson budget "${CHATGPT_MAX_TOKENS:-131072}" '
  def assistant_items:
    if .provider_state.protocol == "chatgpt" then
      if (.provider_state.output | type) == "array" and (.provider_state.output | length) > 0 then .provider_state.output[]
      else error("invalid native continuation") end
    else .blocks[] | if .type == "text" then
      {type:"message",role:"assistant",content:[{type:"output_text",text:.text}]}
      else {type:"function_call",call_id:.id,name:.name,arguments:(.input|tojson)} end end;
  . as $p
  | {model:(.model // $model),instructions:(.system // ""),store:false,stream:true,
     include:["reasoning.encrypted_content"],max_output_tokens:$budget,
     input:[.messages[] | if .role == "user" then
        {type:"message",role:"user",content:[{type:"input_text",text:.content}]}
       elif .role == "tool" then {type:"function_call_output",call_id:.call_id,output:.content}
       else assistant_items end]}
  | if ($p.tools // [] | length) > 0 then .tools=[$p.tools[] |
      {type:"function",name:.name,description:.description,parameters:.input_schema}] else . end
  ' 2>/dev/null)" || { echo 'invalid ChatGPT message continuation' >&2; exit 1; }
if [[ -n "${HARNESS_THINKING:-}" && "${HARNESS_THINKING}" != off ]]; then
  effort="${HARNESS_THINKING}"
  [[ "${effort}" != max ]] || effort=high
  request="$(printf '%s' "${request}" | jq -c --arg effort "${effort}" '.reasoning={effort:$effort}')"
fi

# This endpoint requires SSE. Buffer it privately: no session file or tool dispatch.
sse_output="$(printf '%s' "${request}" | curl -sS "${CHATGPT_API_URL:-https://chatgpt.com/backend-api/codex/responses}" \
  -H "Authorization: Bearer ${access_token}" -H "ChatGPT-Account-ID: ${account_id}" \
  -H 'Content-Type: application/json' -d @- \
  --speed-limit 1 --speed-time "${HARNESS_CURL_SPEED_TIME:-60}" --max-time "${HARNESS_CURL_MAX_TIME:-5400}")" || { echo 'ChatGPT request failed' >&2; exit 1; }
# SSE record framing is text; all event JSON and response parsing goes through jq.
events="$(printf '%s\n' "${sse_output}" | awk '
  function emit() {if (data != "") print data; data=""}
  {sub(/\r$/, "")}
  /^$/ {emit(); next}
  /^data:/ {sub(/^data:[ ]?/, ""); if ($0 != "[DONE]") data=data (data=="" ? "" : "\n") $0}
  END {emit()}
  ' | jq -cs '.' 2>/dev/null)" || { echo 'ChatGPT returned malformed SSE' >&2; exit 1; }
response="$(printf '%s' "${events}" | jq -ce '
  if any(.[]; .type == "error" or .type == "response.failed") then error("API error") else . end
  | [.[] | select(.type == "response.completed" or .type == "response.incomplete") | .response] as $final
  | if ($final | length) != 1 then error("missing or duplicate terminal response") else . end
  | [.[] | select(.type == "response.output_item.done") | {index:.output_index,item:.item}] | sort_by(.index) | map(.item) as $done
  | $final[0]
  | if (.output // [] | length) < ($done | length) then .output=$done else . end
  ' 2>/dev/null)" || { echo 'ChatGPT API returned an error or incomplete SSE response' >&2; exit 1; }
normalized="$(printf '%s' "${response}" | jq -ce '
  if .error != null or (.output | type) != "array" then error("invalid output") else . end
  | if .status == "completed" then .
    elif .status == "incomplete" and .incomplete_details.reason == "max_output_tokens" then .
    else error("missing or unsupported status") end
  | . as $r
  | [.output[] | if .type == "message" and .role == "assistant" then .content[] |
      if .type == "output_text" then {type:"text",text:.text}
      elif .type == "refusal" then {type:"text",text:.refusal}
      else error("unsupported message content") end
    elif .type == "function_call" then
      {type:"tool_call",id:.call_id,name:.name,input:(.arguments|fromjson)}
    elif .type == "reasoning" then empty
    else error("unsupported output item") end] as $blocks
  | {blocks:$blocks,
    stop:(if .status == "incomplete" then "length"
      elif any($blocks[]; .type == "tool_call") then "tool_calls" else "end" end),
    usage:{input_tokens:(.usage.input_tokens // 0),output_tokens:(.usage.output_tokens // 0),
      total_tokens:(.usage.total_tokens // ((.usage.input_tokens // 0)+(.usage.output_tokens // 0))),
      cache_read_input_tokens:(.usage.input_tokens_details.cached_tokens // 0),cache_creation_input_tokens:0},
    provider_state:{protocol:"chatgpt",output:$r.output}}
  ' 2>/dev/null)" || { echo 'ChatGPT API returned malformed output or tool arguments' >&2; exit 1; }
printf '%s' "${normalized}" | _provider_validate_response
