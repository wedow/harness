#!/usr/bin/env bash
# 31-subagent-role — when running as a subagent, inject a prompt override
# clarifying that this agent should execute directly, not delegate further.
set -euo pipefail

payload="$(cat)"

if [[ -z "${HARNESS_PARENT_SESSION:-}" ]]; then
  echo "${payload}"
  exit 0
fi

role='<subagent_role>
You are a subagent — spawned by a parent agent to handle a specific task. Your primary job is to execute that task, not to orchestrate.

You CAN spawn subagents when it genuinely helps — broad searches, parallel exploration, tasks that would flood your context with noise. But each level of delegation adds latency and loses context, so prefer direct execution when the task is straightforward. If your entire purpose is something simple like "search for X" or "read file Y", just do it — do not delegate it further.

Rule of thumb: delegate to protect your context or parallelize work, not to avoid doing the work yourself.
</subagent_role>'

echo "${payload}" | jq --arg role "${role}" '.system = .system + "\n\n" + $role'
