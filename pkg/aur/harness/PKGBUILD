# Maintainer: wedow <wedow@users.noreply.github.com>
pkgname=harness
pkgver=0.5.0
pkgrel=1
pkgdesc="Persistent single-chat agent with separate Bash runtime processes"
arch=('any')
url="https://github.com/wedow/harness"
license=('MIT')
depends=('bash' 'curl' 'jq' 'socat' 'util-linux' 'coreutils')
source=("harness-$pkgver.tar.gz::https://github.com/wedow/harness/archive/refs/tags/v$pkgver.tar.gz")
# sha256sums patched at publish time by publish-aur.sh
sha256sums=('SKIP')

package() {
    cd "harness-$pkgver" >/dev/null || return

    install -d "$pkgdir/usr/lib/harness"
    scripts/release-manifest.sh | while IFS= read -r path; do
        cp -a "$path" "$pkgdir/usr/lib/harness/"
    done

    install -d "$pkgdir/usr/bin"
    sed 's|^HARNESS_ROOT=.*$|HARNESS_ROOT="${HARNESS_ROOT:-/usr/lib/harness}"|' bin/harness > "$pkgdir/usr/bin/harness"
    chmod 755 "$pkgdir/usr/bin/harness"
    ln -s /usr/bin/harness "$pkgdir/usr/bin/hs"

    # A real bundled executable keeps code snapshots independent of /usr/bin.
    install -d "$pkgdir/usr/lib/harness/bin"
    install -m755 bin/harness "$pkgdir/usr/lib/harness/bin/harness"
    ln -s harness "$pkgdir/usr/lib/harness/bin/hs"
}
