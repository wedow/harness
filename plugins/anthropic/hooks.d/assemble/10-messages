#!/usr/bin/env bash
# 10-messages — read canonical session files, produce Anthropic messages array.
# Pipeline hook: receives partial payload on stdin, adds "messages" field.
set -euo pipefail

payload="$(cat)"
msg_dir="${HARNESS_SESSION}/messages"

[[ -d "${msg_dir}" ]] || { echo "${payload}"; exit 0; }

# JSONL accumulation: every emitter appends one compact JSON line; the final
# jq folds once. The old per-message append re-serialized the whole growing
# array through a fresh jq each time — O(n^2) in session size, ~70s for a
# 900-message session.
messages_jsonl=""
tool_results_jsonl=""

flush_tool_results() {
  if [[ -n "${tool_results_jsonl}" ]]; then
    messages_jsonl+="$(printf '%s' "${tool_results_jsonl}" | jq -c -s '{role: "user", content: .}')"$'\n'
    tool_results_jsonl=""
  fi
}

for f in $(ls -1 "${msg_dir}"/*.md 2>/dev/null | sort); do
  _role=""
  _call_id=""
  _error="false"
  _stop=""
  in_fm=false
  fm_done=false
  body=""
  while IFS= read -r line; do
    if [[ "${line}" == "---" ]] && ! ${fm_done}; then
      if ${in_fm}; then in_fm=false; fm_done=true; continue
      else in_fm=true; continue; fi
    fi
    if ${in_fm}; then
      case "${line}" in
        role:*)     _role="${line#role: }" ;;
        call_id:*)  _call_id="${line#call_id: }" ;;
        error:*)    _error="${line#error: }" ;;
        stop:*)     _stop="${line#stop: }" ;;
      esac
    else
      body+="${line}"$'\n'
    fi
  done < "${f}"
  body="${body%$'\n'}"

  case "${_role}" in
    user)
      flush_tool_results
      messages_jsonl+="$(printf '%s' "${body}" | jq -c -Rs '{role: "user", content: .}')"$'\n'
      ;;
    assistant)
      flush_tool_results
      content_blocks_jsonl=""
      current_text=""
      in_tool_block=false
      in_thinking_block=false
      tool_id="" tool_name="" tool_body=""
      thinking_sig="" thinking_text=""
      # Fences grow to one past any leading backtick run inside the block
      # (see receive/10-save), so embedded ``` inside thinking cannot terminate
      # a block early. Close only on the exact opening length.
      think_fence='```' call_fence='```'

      _flush_text() {
        if [[ -n "${current_text}" ]]; then
          local _flush="${current_text%$'\n'}"
          local _flush_trimmed="${_flush//[$'\n\t ']/}"
          if [[ -n "${_flush_trimmed}" ]]; then
            content_blocks_jsonl+="$(printf '%s' "${_flush}" | jq -c -Rs '{type: "text", text: .}')"$'\n'
          fi
          current_text=""
        fi
      }

      while IFS= read -r line; do
        if ${in_thinking_block}; then
          if [[ "${line}" == "${think_fence}" ]]; then
            in_thinking_block=false
            thinking_text="${thinking_text%$'\n'}"
            content_blocks_jsonl+="$(printf '%s' "${thinking_text}" | jq -c -Rs --arg sig "${thinking_sig}" '{type: "thinking", thinking: ., signature: $sig}')"$'\n'
          else
            thinking_text+="${line}"$'\n'
          fi
          continue
        fi
        if ${in_tool_block}; then
          if [[ "${line}" == "${call_fence}" ]]; then
            in_tool_block=false
            content_blocks_jsonl+="$(printf '%s' "${tool_body}" | jq -c --arg id "${tool_id}" --arg name "${tool_name}" '{type: "tool_use", id: $id, name: $name, input: .}')"$'\n'
          else
            tool_body+="${line}"
          fi
          continue
        fi
        if [[ "${line}" =~ ^(\`{3,})thinking\ signature=(.+)$ ]]; then
          _flush_text
          in_thinking_block=true
          think_fence="${BASH_REMATCH[1]}"
          thinking_sig="${BASH_REMATCH[2]}"
          thinking_text=""
          continue
        fi
        if [[ ( "${_stop}" == "tool_calls" || -z "${_stop}" ) && "${line}" =~ ^(\`{3,})tool_call\ id=([^ ]+)\ name=([^ ]+)$ ]]; then
          _flush_text
          in_tool_block=true
          call_fence="${BASH_REMATCH[1]}"
          tool_id="${BASH_REMATCH[2]}"
          tool_name="${BASH_REMATCH[3]}"
          tool_body=""
          continue
        fi
        current_text+="${line}"$'\n'
      done <<< "${body}"

      _flush_text

      if [[ -n "${content_blocks_jsonl}" ]]; then
        messages_jsonl+="$(printf '%s' "${content_blocks_jsonl}" | jq -c -s \
          'if (length == 1) and (.[0].type == "text") then {role: "assistant", content: .[0].text} else {role: "assistant", content: .} end')"$'\n'
      fi
      ;;
    tool_result)
      if [[ "${_error}" == "true" ]]; then
        tool_results_jsonl+="$(printf '%s' "${body}" | jq -c -Rs --arg id "${_call_id}" \
          '{type: "tool_result", tool_use_id: $id, content: ., is_error: true}')"$'\n'
      else
        tool_results_jsonl+="$(printf '%s' "${body}" | jq -c -Rs --arg id "${_call_id}" \
          '{type: "tool_result", tool_use_id: $id, content: .}')"$'\n'
      fi
      ;;
  esac
done

flush_tool_results

# The Anthropic API requires alternating roles. A user message inserted
# mid-turn (live steering from the web UI) can land right after tool results,
# producing two consecutive user turns — merge consecutive user messages
# into one (string content becomes a text block; arrays concatenate).
printf '%s\n%s\n' "${payload}" "${messages_jsonl}" | jq -c -s '
  (.[1:] | reduce .[] as $m ([];
    if ($m.role == "user") and (length > 0) and (.[-1].role == "user")
    then .[-1] = (.[-1] + {content: (
        ([.[-1].content | if type == "string" then [{type: "text", text: .}] else . end]
         + [$m.content   | if type == "string" then [{type: "text", text: .}] else . end]) | add)})
    else . + [$m] end)) as $msgs
  | .[0] + {messages: $msgs}'
